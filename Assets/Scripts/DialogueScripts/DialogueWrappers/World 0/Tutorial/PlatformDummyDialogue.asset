  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0c4ba83377da9aa4d989fd8875452eae, type: 3}
  m_Name: PlatformDummyDialogue
  m_EditorClassIdentifier: 
  dialogue:
  - bodyText: Hmm, how would I hit that dummy above us...
    speakerName: Jamie
    displayingImage: {fileID: 21300000, guid: e97d70049b5514d0dbe229dc7380a76b, type: 3}
    highlightedWords: []
    shadow: 0
    broadcastAnEvent: 0
  - bodyText: I know! If I get the angle just right... I can grapple up there with my harpoon gun!
    speakerName: Jaime
    displayingImage: {fileID: 21300000, guid: e45f1839db2784540934541013900a29, type: 3}
    highlightedWords: []
    shadow: 0
    broadcastAnEvent: 0
  - bodyText: Each weapon has a unique skill which is activated by pressing [Q]. Using the Harpoon Gun's skill will pull you to the last semi-solid platform or enemy you hit.
    speakerName: Tutorial
    displayingImage: {fileID: 0}
    highlightedWords:
    - semi-solid platform
    - enemy
    shadow: 0
    broadcastAnEvent: 0
  - bodyText: You can only use the skill every once in a while. Keep track of it's cooldown by watching the white bar in the top-left corner.
    speakerName: Tutorial
    displayingImage: {fileID: 0}
    highlightedWords: []
    shadow: 0
    broadcastAnEvent: 0
  - bodyText: Alright, let's give this a shot!
    speakerName: Jaime
    displayingImage: {fileID: 21300000, guid: e45f1839db2784540934541013900a29, type: 3}
    highlightedWords: []
    shadow: 0
    broadcastAnEvent: 0
  yarnDialogue:
    project: {fileID: 7545569452688597077, guid: 40cab0cfd74c5c64caf0b460479d0797, type: 3}
    nodeName: Legacy_8751140c175993f44aeb4dbe6734cbf9
